# Object store (S3-compatible). Swap S3_ENDPOINT to point at real S3.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=propmatch
AWS_REGION=us-east-1

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=propmatch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=propmatch

# Crawler
CRAWL_RATE_LIMIT_SECONDS=2
CRAWL_MAX_RETRIES=3
CRAWL_USER_AGENTS_FILE=config/user_agents.txt

# Entity resolution
ER_MATCH_THRESHOLD=0.82
ER_MIN_WEIGHT_SUM=0.50
ER_MAX_CLUSTER_SIZE=10
ER_SUBBLOCK_LIMIT=1000
